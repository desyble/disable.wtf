local function getModelPartsByGroup(model)
	local groups = {}
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			if not groups[child.Name] then groups[child.Name] = {} end
			table.insert(groups[child.Name], child)
		end
	end
	return groups
end

local function copyModelVisuals(srcModel, dstModel)
	local srcGroups = getModelPartsByGroup(srcModel)
	local dstGroups = getModelPartsByGroup(dstModel)
	for name, srcList in pairs(srcGroups) do
		local dstList = dstGroups[name]
		if dstList then
			for i, srcPart in ipairs(srcList) do
				if dstList[i] then
					copyVisualProps(srcPart, dstList[i])
				end
			end
		end
	end
end

local function saveVisualBackup(tool)
	if skinBackups[tool] then return end
	local backup = {
		toolTextureId = tool.TextureId,
		handle = nil,
		chamber = nil,
		muzzle = nil,
		muzzleParticles = {},
		modelClone = nil,
	}

	local function saveBasePart(part)
		if not part or not part:IsA("BasePart") then return nil end
		local info = {
			Color = part.Color,
			Material = part.Material,
			Transparency = part.Transparency,
			Reflectance = part.Reflectance,
		}
		if part:IsA("MeshPart") then
			info.MeshId = part.MeshId
			info.TextureID = part.TextureID
		end
		local sMesh = part:FindFirstChildOfClass("SpecialMesh")
		if sMesh then
			info.specialMesh = {
				MeshId = sMesh.MeshId,
				TextureId = sMesh.TextureId,
				Scale = sMesh.Scale,
				Offset = sMesh.Offset,
			}
		end
		info.surfaceChildren = {}
		for _, c in ipairs(part:GetChildren()) do
			if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture") then
				info.surfaceChildren[#info.surfaceChildren + 1] = c:Clone()
			end
		end
		return info
	end

	backup.handle = saveBasePart(tool:FindFirstChild("Handle"))
	backup.chamber = saveBasePart(tool:FindFirstChild("Chamber"))
	backup.muzzle = saveBasePart(tool:FindFirstChild("Muzzle"))

	local muzzle = tool:FindFirstChild("Muzzle")
	if muzzle then
		for _, child in ipairs(muzzle:GetChildren()) do
			if child:IsA("ParticleEmitter") then
				backup.muzzleParticles[child.Name] = saveParticleProps(child)
			end
		end
	end

	local model = tool:FindFirstChild("Model")
	if model then
		backup.modelClone = model:Clone()
	end

	skinBackups[tool] = backup
end

local function restoreVisualBackup(tool)
	local backup = skinBackups[tool]
	if not backup then return false end

	local function restoreBasePart(part, info)
		if not part or not part:IsA("BasePart") or not info then return end
		part.Color = info.Color
		part.Material = info.Material
		part.Transparency = info.Transparency
		part.Reflectance = info.Reflectance
		if part:IsA("MeshPart") and info.MeshId then
			pcall(function() part.MeshId = info.MeshId end)
			pcall(function() part.TextureID = info.TextureID end)
		end
		local existingMesh = part:FindFirstChildOfClass("SpecialMesh")
		if info.specialMesh then
			if not existingMesh then
				existingMesh = Instance.new("SpecialMesh")
				existingMesh.Parent = part
			end
			pcall(function() existingMesh.MeshId = info.specialMesh.MeshId end)
			pcall(function() existingMesh.TextureId = info.specialMesh.TextureId end)
			existingMesh.Scale = info.specialMesh.Scale
			existingMesh.Offset = info.specialMesh.Offset
		elseif existingMesh then
			existingMesh:Destroy()
		end
		for _, c in ipairs(part:GetChildren()) do
			if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture") then
				c:Destroy()
			end
		end
		for _, c in ipairs(info.surfaceChildren) do
			if c and not c.Parent then
				c:Clone().Parent = part
			end
		end
	end

	local model = tool:FindFirstChild("Model")
	if model and backup.modelClone then
		copyModelVisuals(backup.modelClone, model)
	end

	restoreBasePart(tool:FindFirstChild("Handle"), backup.handle)
	restoreBasePart(tool:FindFirstChild("Chamber"), backup.chamber)

	local muzzle = tool:FindFirstChild("Muzzle")
	restoreBasePart(muzzle, backup.muzzle)
	if muzzle then
		for name, savedProps in pairs(backup.muzzleParticles) do
			local emitter = muzzle:FindFirstChild(name)
			if emitter and emitter:IsA("ParticleEmitter") then
				restoreParticleProps(emitter, savedProps)
			end
		end
	end

	pcall(function() tool.TextureId = backup.toolTextureId end)

	return true
end



