local function applySkinSounds(tool, skinCfg)
	if not tool or not skinCfg then return end

	if skinCfg.TracerColor then
		local cfgModule = Configuration and Configuration:FindFirstChild(tool.Name)
		if cfgModule and cfgModule:IsA("ModuleScript") then
			local s, c = pcall(require, cfgModule)
			if s and c then
				if originalTracerColor == nil then
					originalTracerColor = c.TracerColor
				end
				c.TracerColor = skinCfg.TracerColor
			end
		end
	end

	if skinCfg.Sounds then
		local handle = tool:FindFirstChild("Handle")
		if handle then
			for soundName, soundData in pairs(skinCfg.Sounds) do
				local snd = handle:FindFirstChild(soundName)
				if snd and snd:IsA("Sound") then
					if not originalHandleSounds[snd] then
						originalHandleSounds[snd] = {
							SoundId = snd.SoundId,
							Volume = snd.Volume,
							RollOffMaxDistance = snd.RollOffMaxDistance,
							RollOffMinDistance = snd.RollOffMinDistance,
						}
					end
					if soundData.Id then snd.SoundId = soundData.Id end
					if soundData.Volume then snd.Volume = soundData.Volume end
					if soundData.RollOffMaxDistance then snd.RollOffMaxDistance = soundData.RollOffMaxDistance end
					if soundData.RollOffMinDistance then snd.RollOffMinDistance = soundData.RollOffMinDistance end
				end
			end
		end
	end
end

local function restoreSkinSounds(tool)
	if not tool then return end
	if originalTracerColor ~= nil then
		local cfgModule = Configuration and Configuration:FindFirstChild(tool.Name)
		if cfgModule and cfgModule:IsA("ModuleScript") then
			local s, c = pcall(require, cfgModule)
			if s and c then c.TracerColor = originalTracerColor end
		end
		originalTracerColor = nil
	end
	for snd, props in pairs(originalHandleSounds) do
		if snd and snd.Parent then
			snd.SoundId = props.SoundId
			snd.Volume = props.Volume
			snd.RollOffMaxDistance = props.RollOffMaxDistance
			snd.RollOffMinDistance = props.RollOffMinDistance
		end
	end
	originalHandleSounds = {}
end

