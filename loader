					dChild.PlaybackSpeed = sChild.PlaybackSpeed
					dChild.RollOffMaxDistance = sChild.RollOffMaxDistance
					dChild.RollOffMinDistance = sChild.RollOffMinDistance
				end)
			end
		end
	end
