local function IsRagebotVisible(fromPos, targetPart)
	if not Ragebot.WallCheck then return true end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LocalPlayer.Character}
	params.IgnoreWater = false

	local dir = (targetPart.Position - fromPos)
	local dist = dir.Magnitude
	if dist <= 0 then return false end

	local result = Workspace:Raycast(fromPos, dir, params)
	if result then
		local hitPart = result.Instance
		if hitPart and targetPart:IsDescendantOf(hitPart) then
			return true
		end
		local hitChar = hitPart and hitPart.Parent
		if hitChar and hitChar == targetPart.Parent then
			return true
		end
		return false
	end
	return true
end

