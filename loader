local origTextureCache = {}
local origFaceCache = {}

local function applyViewmodelToPart(part, isBody)
	if not part:IsA("BasePart") then return end
	if isBody then
		if Viewmodel.BodyEnabled then
			if part:IsA("MeshPart") then
				if part.TextureID ~= "" then
					origTextureCache[part] = part.TextureID
				end
				if Viewmodel.BodyMaterial ~= "ForceField" then
					part.TextureID = ""
				elseif origTextureCache[part] then
					part.TextureID = origTextureCache[part]
				end
			end
			if part.Name == "Head" then
				local face = part:FindFirstChildOfClass("Decal")
				if face then
					if face.Texture ~= "" then origFaceCache[face] = face.Texture end
					if Viewmodel.BodyMaterial ~= "ForceField" then
						face.Transparency = 1
					else
						face.Transparency = 0
					end
				end
			end
			part.Color = Viewmodel.BodyColor
			part.Material = materialEnumMap[Viewmodel.BodyMaterial] or Enum.Material.ForceField
			part.Transparency = Viewmodel.BodyTransparency
		else
			if part:IsA("MeshPart") and origTextureCache[part] then
				part.TextureID = origTextureCache[part]
			end
			if part.Name == "Head" then
				local face = part:FindFirstChildOfClass("Decal")
				if face then
					face.Transparency = 0
					if origFaceCache[face] then face.Texture = origFaceCache[face] end
				end
			end
		end
	else
		if Viewmodel.GunEnabled then
			if part:IsA("MeshPart") then
				if part.TextureID ~= "" then
					origTextureCache[part] = part.TextureID
				end
				if Viewmodel.GunMaterial ~= "ForceField" then
					part.TextureID = ""
				elseif origTextureCache[part] then
					part.TextureID = origTextureCache[part]
				end
			end
			part.Color = Viewmodel.GunColor
			part.Material = materialEnumMap[Viewmodel.GunMaterial] or Enum.Material.Neon
			part.Transparency = Viewmodel.GunTransparency
		else
			if part:IsA("MeshPart") and origTextureCache[part] then
				part.TextureID = origTextureCache[part]
			end
		end
	end
end

