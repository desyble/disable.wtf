local function fireAutoRevive()
	if not AutoRevive.Enabled then return end
	if not RespawnEvent then
		RespawnEvent = ReplicatedStorage:FindFirstChild("RespawnEvent")
	end
	if RespawnEvent then
		pcall(function() RespawnEvent:FireServer() end)
	end
end

local function setupAutoReviveForCharacter(char)
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local function tryRevive()
		if AutoRevive.Enabled then
			task.wait(0.5)
			fireAutoRevive()
		end
	end

	if hum:GetAttribute("Dead") == true then
		tryRevive()
	end
	hum:GetAttributeChangedSignal("Dead"):Connect(function()
		if hum:GetAttribute("Dead") == true then
			tryRevive()
		end
	end)
	hum.Died:Connect(tryRevive)
	hum.HealthChanged:Connect(function(hp)
		if hp <= 0 then tryRevive() end
	end)
end

if LocalPlayer.Character then setupAutoReviveForCharacter(LocalPlayer.Character) end
