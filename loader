	outline.Visible = false

	local segments = {}
	for i = 1, TRACER_SEGMENTS do
		local seg = Drawing.new("Line")
		seg.Transparency = 1
		seg.Visible = false
		segments[i] = seg
	end
	return { outline = outline, segments = segments }
end

