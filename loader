local function getSkeletonJoints(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local isR15 = hum and hum.RigType == Enum.HumanoidRigType.R15
	local joints = {}
	local function getPos(name)
		local p = char:FindFirstChild(name)
		return p and p.Position
	end
	if isR15 then
		local head = getPos("Head")
		local upperTorso = getPos("UpperTorso")
		local lowerTorso = getPos("LowerTorso")
		local leftUpperArm = getPos("LeftUpperArm")
		local leftLowerArm = getPos("LeftLowerArm")
		local leftHand = getPos("LeftHand")
		local rightUpperArm = getPos("RightUpperArm")
		local rightLowerArm = getPos("RightLowerArm")
		local rightHand = getPos("RightHand")
		local leftUpperLeg = getPos("LeftUpperLeg")
		local leftLowerLeg = getPos("LeftLowerLeg")
		local leftFoot = getPos("LeftFoot")
		local rightUpperLeg = getPos("RightUpperLeg")
		local rightLowerLeg = getPos("RightLowerLeg")
		local rightFoot = getPos("RightFoot")
		
		if head and upperTorso then table.insert(joints, {head, upperTorso}) end
		if upperTorso and lowerTorso then table.insert(joints, {upperTorso, lowerTorso}) end
		if upperTorso and leftUpperArm then table.insert(joints, {upperTorso, leftUpperArm}) end
		if leftUpperArm and leftLowerArm then table.insert(joints, {leftUpperArm, leftLowerArm}) end
		if leftLowerArm and leftHand then table.insert(joints, {leftLowerArm, leftHand}) end
		if upperTorso and rightUpperArm then table.insert(joints, {upperTorso, rightUpperArm}) end
		if rightUpperArm and rightLowerArm then table.insert(joints, {rightUpperArm, rightLowerArm}) end
		if rightLowerArm and rightHand then table.insert(joints, {rightLowerArm, rightHand}) end
		if lowerTorso and leftUpperLeg then table.insert(joints, {lowerTorso, leftUpperLeg}) end
		if leftUpperLeg and leftLowerLeg then table.insert(joints, {leftUpperLeg, leftLowerLeg}) end
		if leftLowerLeg and leftFoot then table.insert(joints, {leftLowerLeg, leftFoot}) end
		if lowerTorso and rightUpperLeg then table.insert(joints, {lowerTorso, rightUpperLeg}) end
		if rightUpperLeg and rightLowerLeg then table.insert(joints, {rightUpperLeg, rightLowerLeg}) end
		if rightLowerLeg and rightFoot then table.insert(joints, {rightLowerLeg, rightFoot}) end
	else
		local head = getPos("Head")
		local torso = getPos("Torso")
		local leftArm = getPos("Left Arm")
		local rightArm = getPos("Right Arm")
		local leftLeg = getPos("Left Leg")
		local rightLeg = getPos("Right Leg")
		
		if head and torso then table.insert(joints, {head, torso}) end
		if torso and leftArm then table.insert(joints, {torso, leftArm}) end
		if torso and rightArm then table.insert(joints, {torso, rightArm}) end
		if torso and leftLeg then table.insert(joints, {torso, leftLeg}) end
		if torso and rightLeg then table.insert(joints, {torso, rightLeg}) end
	end
	return joints
end

local function getSkeletonDrawings(plr)
	if not skeletonLines[plr] then
		local drawings = {}
		for i = 1, 14 do
			local outline = Drawing.new("Line")
			outline.Color = Color3.fromRGB(0, 0, 0)
			outline.Thickness = 3
			outline.Transparency = 1
			outline.Visible = false
			
			local main = Drawing.new("Line")
			main.Color = ESP.SkeletonColor
			main.Thickness = 1
			main.Transparency = 1
			main.Visible = false
			
			table.insert(drawings, {outline = outline, main = main})
		end
		skeletonLines[plr] = drawings
	end
	return skeletonLines[plr]
end

local function removeSkeletonDrawings(plr)
	if skeletonLines[plr] then
		for _, draw in ipairs(skeletonLines[plr]) do
			draw.outline:Remove()
			draw.main:Remove()
		end
		skeletonLines[plr] = nil
	end
end

local function removeAllSkeleton()
	for plr, drawings in pairs(skeletonLines) do
		for _, draw in ipairs(drawings) do
			draw.outline:Remove()
			draw.main:Remove()
		end
	end
	skeletonLines = {}
end

function updateSkeleton()
	if not ESP.SkeletonEnabled then
		removeAllSkeleton()
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local alive = char and IsCharacterAlive(char)
			if char and alive then
				local joints = getSkeletonJoints(char)
				local drawings = getSkeletonDrawings(player)
				for i = 1, 14 do
					local d = drawings[i]
					local jointPair = joints[i]
					if jointPair then
						local p1, p2 = jointPair[1], jointPair[2]
						local s1, vis1 = camera:WorldToViewportPoint(p1)
						local s2, vis2 = camera:WorldToViewportPoint(p2)
						if vis1 and vis2 and s1.Z > 0 and s2.Z > 0 then
							d.outline.From = Vector2.new(s1.X, s1.Y)
							d.outline.To = Vector2.new(s2.X, s2.Y)
							d.outline.Visible = true
							
							d.main.From = Vector2.new(s1.X, s1.Y)
							d.main.To = Vector2.new(s2.X, s2.Y)
							d.main.Color = ESP.SkeletonColor
							d.main.Visible = true
						else
							d.outline.Visible = false
							d.main.Visible = false
						end
					else
						d.outline.Visible = false
						d.main.Visible = false
					end
				end
			else
				removeSkeletonDrawings(player)
			end
		end
	end
	for plr in pairs(skeletonLines) do
		if not plr.Parent then removeSkeletonDrawings(plr) end
	end
end

