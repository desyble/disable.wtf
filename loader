local HITBOX_PART_NAMES = {"Head"}

function applyHitboxToChar(char)
	if not char or not char.Parent then return end
	local plr = Players:GetPlayerFromCharacter(char)
	if not plr or plr == LocalPlayer then return end
	if not hitboxBackups[char] then
		hitboxBackups[char] = {}
		for _, name in ipairs(HITBOX_PART_NAMES) do
			local part = char:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				hitboxBackups[char][part] = part.Size
				for _, child in ipairs(part:GetChildren()) do
					if child:IsA("Decal") or child:IsA("Texture") then
						hitboxBackups[char][child] = child.Transparency
					end
				end
			end
		end
	end
	local hideFace = HitboxExpander.Transparency >= 1.0
	for inst, orig in pairs(hitboxBackups[char]) do
		if inst and inst.Parent then
			if inst:IsA("BasePart") then
				inst.Size = orig * HitboxExpander.Multiplier
				inst.LocalTransparencyModifier = HitboxExpander.Transparency
				inst.CanCollide = false
				inst.Massless = true
			elseif inst:IsA("Decal") or inst:IsA("Texture") then
				if hideFace then
					inst.Transparency = 1
				else
					inst.Transparency = orig
				end
			end
		end
	end
end

function restoreHitboxChar(char)
	if not hitboxBackups[char] then return end
	for inst, orig in pairs(hitboxBackups[char]) do
		if inst and inst.Parent then
			if inst:IsA("BasePart") then
				inst.Size = orig
				inst.LocalTransparencyModifier = 0
				inst.CanCollide = true
				inst.Massless = false
			elseif inst:IsA("Decal") or inst:IsA("Texture") then
				inst.Transparency = orig
			end
		end
	end
	hitboxBackups[char] = nil
end

function restoreAllHitboxes()
	for char in pairs(hitboxBackups) do
		restoreHitboxChar(char)
	end
	hitboxBackups = {}
end

