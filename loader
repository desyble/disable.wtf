local function InitMiscHooks()
	local ok, ZS = pcall(function() return ReplicatedStorage:WaitForChild("ZexisShared", 10) end)
	if not ok or not ZS then warn("[disable.wtf] ZexisShared not found"); return end
	local Modules = ZS:FindFirstChild("Modules"); if not Modules then return end

	local animMod = Modules:FindFirstChild("Animator")
	if animMod then
		local Animator = require(animMod)
		OrigAnimPlay = Animator.Play; OrigAnimStop = Animator.Stop
		Animator.Play = function(p1,p2,p3,p4) if Misc.NoAnimations then return nil end; return OrigAnimPlay(p1,p2,p3,p4) end
		Animator.Stop = function(p1,p2,p3,p4) if Misc.NoAnimations then return end; return OrigAnimStop(p1,p2,p3,p4) end
	end

	local camMod = Modules:FindFirstChild("ZexisCamera")
	if camMod then
		local ZC = require(camMod)
		OrigCamFOV = ZC.FOV
		ZC.FOV = function(self, fov) if Misc.NoScope then return end; return OrigCamFOV(self, fov) end
		OrigUpdateCamPos = ZC.UpdateCameraPosition
		ZC.UpdateCameraPosition = function(self)
			if Aimbot.Enabled then
				local active = (not Options) or (not Options.AimbotKeybind) or Options.AimbotKeybind:GetState()
				if active then
					local target = GetAimbotTarget()
					if target then
						local myChar = LocalPlayer.Character
						local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
						local cam = Workspace.CurrentCamera
						local origin = cam and cam.CFrame.Position
						if origin then
							local dir = target.Position - origin
							if dir.Magnitude > 0.1 then
								dir = dir.Unit
								local dYaw = math.atan2(-dir.X, -dir.Z)
								local dPitch = math.clamp(math.asin(math.clamp(dir.Y,-1,1)), -math.rad(75), math.rad(75))
								if not aimbotAngles then aimbotAngles = Vector2.new(self.angles.X, self.angles.Y) end
								local a = 1 / math.max(Aimbot.Smooth, 1)
								local dy = dYaw - aimbotAngles.Y
								if dy > math.pi then dy = dy - 2*math.pi elseif dy < -math.pi then dy = dy + 2*math.pi end
								aimbotAngles = Vector2.new(aimbotAngles.X + (dPitch-aimbotAngles.X)*a, aimbotAngles.Y + dy*a)
								self.angles = aimbotAngles
							end
						end
					else aimbotAngles = nil end
				else
					if aimbotAngles then
						self.angles = aimbotAngles
						aimbotAngles = nil
					end
				end
			end
			return OrigUpdateCamPos(self)
		end
	end

	local aimbotAimPoint = nil
	RunService:BindToRenderStep("AimbotCorrection", 2002, function()
		if not Aimbot.Enabled or not PlumeRunning then aimbotAimPoint = nil; return end
		local active = (not Options) or (not Options.AimbotKeybind) or Options.AimbotKeybind:GetState()
		if not active then aimbotAimPoint = nil; return end
		local target = GetAimbotTarget()
		if not target then aimbotAimPoint = nil; return end
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local targetPos = target.Position
		if not aimbotAimPoint then
			local dist = (targetPos - cam.CFrame.Position).Magnitude
			aimbotAimPoint = cam.CFrame.Position + cam.CFrame.LookVector * math.max(dist, 1)
		end
		local a = 1 / math.max(Aimbot.Smooth, 1)
		aimbotAimPoint = aimbotAimPoint + (targetPos - aimbotAimPoint) * a
		local camPos = cam.CFrame.Position
		if (aimbotAimPoint - camPos).Magnitude > 0.1 then
			cam.CFrame = CFrame.new(camPos, aimbotAimPoint)
		end
	end)

	local guiMod = Modules:FindFirstChild("Gui")
	if guiMod then
		local Gui = require(guiMod)

		local OrigToggleCrosshair = Gui.ToggleCrosshair
		Gui.ToggleCrosshair = function(p1, visible)
			if not visible and Aimbot.Enabled then
				return
			end
			return OrigToggleCrosshair(p1, visible)
		end

		local OrigGuiScope = Gui.Scope
		Gui.Scope = function(p1, scopeOn, weaponCfg, p4, p5)
			if scopeOn and Aimbot.Enabled then
				if LocalPlayer.Character then
					ZC:FOV(20)
				end
				return
			end
			return OrigGuiScope(p1, scopeOn, weaponCfg, p4, p5)
		end
	end

	Configuration = ZS:FindFirstChild("Configuration")
	if Configuration then
		Configuration.ChildAdded:Connect(function(child)
			if child:IsA("ModuleScript") and Misc.NoShotDelay then
				task.wait(0.1); local s,cfg = pcall(require,child)
				if s and cfg and cfg.Rate ~= nil then originalRates[child.Name] = cfg.Rate; cfg.Rate = 0 end
			end
		end)
	end
end

local function ApplyNoShotDelay()
	if not Configuration then return end
	for _,m in ipairs(Configuration:GetChildren()) do
		if m:IsA("ModuleScript") then
			local s,cfg = pcall(require,m)
			if s and cfg and cfg.Rate ~= nil then
				if not originalRates[m.Name] then originalRates[m.Name] = cfg.Rate end; cfg.Rate = 0
			end
		end
	end
end
local function RestoreShotDelay()
	if not Configuration then return end
	for _,m in ipairs(Configuration:GetChildren()) do
		if m:IsA("ModuleScript") then
			local s,cfg = pcall(require,m); if s and cfg and originalRates[m.Name] then cfg.Rate = originalRates[m.Name] end
		end
	end
end

