	local myChar = LocalPlayer.Character
	if not myChar then return nil end
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return nil end

	local bestPart = nil
	local bestDist = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not isTeammate(player) then
			local char = player.Character
			if char and IsRagebotTargetAlive(char) then
				local targetPart = char:FindFirstChild(Ragebot.Target)
				if targetPart and targetPart:IsA("BasePart") then
					local dist = (targetPart.Position - camPos).Magnitude
					if dist < bestDist and dist <= Ragebot.Range then
						if IsRagebotVisible(myHrp.Position, targetPart) then
							bestDist = dist
							bestPart = targetPart
						end
					end
				end
