local function playAAEmoteWithId(animId)
	local char = LocalPlayer.Character; if not char then return false end
	local hum = char:FindFirstChildWhichIsA("Humanoid"); if not hum then return false end
	if not IsCharacterAlive(char) then return false end
	if aaEmoteTrack and aaEmoteChar == char then
		local playing = false
		pcall(function() playing = aaEmoteTrack.IsPlaying end)
		if playing then
			pcall(function() aaEmoteTrack:AdjustSpeed(tonumber(EmoteAA.Speed) or 1) end)
			return true
		end
	end
	local watch = aaEmoteWatch
	aaEmoteWatch = nil
	if watch then pcall(function() task.cancel(watch) end) end
	if aaEmoteTrack then
		pcall(function() aaEmoteTrack:Stop(0) end)
		pcall(function() aaEmoteTrack:Destroy() end)
		aaEmoteTrack = nil
	end
	if aaEmoteAnim then
		pcall(function() aaEmoteAnim:Destroy() end)
		aaEmoteAnim = nil
	end
	local rawId = tostring(EmoteAA.ID):match("(%d+)") or tostring(EmoteAA.ID)
	pcall(function()
		for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
			local aid = ""
			pcall(function() aid = t.Animation and t.Animation.AnimationId or "" end)
			if aid:find(rawId, 1, true) then t:Stop(0); t:Destroy() end
		end
	end)
	noanim()
	local speed = tonumber(EmoteAA.Speed) or 1
	local track, animInst = nil, nil
	local okPE, peTrack = pcall(function() return hum:PlayEmoteAndGetAnimTrackById(tonumber(rawId)) end)
	if okPE and peTrack then
		track = peTrack
		pcall(function() track.Looped = true; if not track.IsPlaying then track:Play() end; track:AdjustSpeed(speed) end)
	end
	if not track then
		pcall(function()
			local anim = Instance.new("Animation")
			anim.AnimationId = animId
			animInst = anim
			local t = hum:LoadAnimation(anim)
			t.Priority = Enum.AnimationPriority.Action
			t.Looped = true
			t:Play()
			if speed ~= 1 then t:AdjustSpeed(speed) end
			track = t
		end)
		if not track then pcall(function() if animInst then animInst:Destroy() end end); animInst = nil end
	end
	if not track then
		pcall(function()
			local animator = hum:FindFirstChildOfClass("Animator")
			if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
			local anim = Instance.new("Animation")
			anim.AnimationId = animId
			animInst = anim
			local t = animator:LoadAnimation(anim)
			t.Priority = Enum.AnimationPriority.Action
			t.Looped = true
			t:Play()
			if speed ~= 1 then t:AdjustSpeed(speed) end
			track = t
		end)
		if not track then pcall(function() if animInst then animInst:Destroy() end end); animInst = nil; reanim(); return false end
	end
	pcall(function() track.Looped = true; if not track.IsPlaying then track:Play() end; track:AdjustSpeed(speed) end)
	aaEmoteTrack = track
	aaEmoteAnim = animInst
	aaEmoteChar = char
	aaEmoteWatch = task.spawn(function()
		while EmoteAA.Enabled do
			task.wait(0.35)
			if not EmoteAA.Enabled then break end
			local c = LocalPlayer.Character
			local h = c and c:FindFirstChildWhichIsA("Humanoid")
			if not c or not h or not IsCharacterAlive(c) then continue end
			local a = c:FindFirstChild("Animate")
			if a and not a.Disabled then pcall(function() a.Disabled = true end); aaAnimateWasDisabled = true end
			if aaEmoteChar ~= c then
				if EmoteAA.Enabled then resolveEmoteAnimId(EmoteAA.ID, playAAEmoteWithId) end
				return
			end
			local playing = false
			pcall(function() playing = aaEmoteTrack and aaEmoteTrack.IsPlaying end)
			if not playing then
				if EmoteAA.Enabled then resolveEmoteAnimId(EmoteAA.ID, playAAEmoteWithId) end
				return
			else
				pcall(function() aaEmoteTrack.Looped = true; aaEmoteTrack:AdjustSpeed(tonumber(EmoteAA.Speed) or 1) end)
			end
		end
	end)
	return true
end

local function playAAEmote()
	resolveEmoteAnimId(EmoteAA.ID, playAAEmoteWithId)
