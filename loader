function killAuraValidTarget(plr)
	if plr == LocalPlayer then return false end
	if isTeammate(plr) then return false end
	local char = plr.Character; if not char or not char.Parent then return false end
	if KillAura.DeathCheck and not IsCharacterAlive(char) then return false end
	if hasFF(char) then return false end
	local root = getRoot(char); if not root then return false end
	local origin = myOrigin(); if not origin then return false end
	local dist = (origin - root.Position).Magnitude
	if dist > KillAura.MaxDist then return false end
	local part, hitPos, aimPos = bestVisibleAim(origin, char)
	if not part then return false end
	return true, char, part, root, dist, origin, hitPos, aimPos
end

function killAuraFireEntry(entry)
	if not CombatEvent then loadCombatEvent(); return false end
	if not holdingTool() then return false end
	
	local now = tick()
	if now - lastShotAt < KillAura.MinShotInterval then
		task.wait(KillAura.MinShotInterval - (now - lastShotAt))
	end
	
	local origin = myOrigin(); if not origin then return false end
	if not entry.char or not entry.char.Parent then return false end
	if KillAura.DeathCheck and not IsCharacterAlive(entry.char) then return false end
	if isTeammate(entry.plr) then return false end

	local part, hitPos, aimPos = bestVisibleAim(origin, entry.char)
	if not part or not hitPos then return false end

	if KillAura.WallCheck and not isPathClear(origin, hitPos, entry.char) then 
		return false 
	end

	local shots = KillAura.ShotsPerBurst or 1
	local bullets = {}
	local uids = {}
	
	for i = 1, shots do
		local uid = genUID()
		table.insert(uids, uid)
		table.insert(bullets, {
			Direction = hitPos,
			Origin = origin,
			UID = uid
		})
	end
	
	local ok1 = pcall(function()
		CombatEvent:FireServer("Fire", bullets, KillAura.AMMO_VALUE)
	end)
	if not ok1 then return false end
	
	for i = 1, #bullets do
		if BulletTracer.Enabled then addTracer(origin, hitPos) end
	end
	
	task.spawn(function()
		for _, uid in ipairs(uids) do
			if not entry.char or not entry.char.Parent then break end
			if KillAura.DeathCheck and not IsCharacterAlive(entry.char) then break end
			
			origin = myOrigin() or origin
			local p, hp = bestVisibleAim(origin, entry.char)
			if not p or not hp then break end
			if KillAura.WallCheck and not isPathClear(origin, hp, entry.char) then break end
			
			local sent = false
			for _ = 1, KillAura.HitRetries do
				local ok2 = pcall(function()
					CombatEvent:FireServer(KillAura.HIT_HASH, entry.char, p, uid, hp)
				end)
				if ok2 then sent = true; break end
				task.wait(0.01)
			end
			
			if sent then
				shotCounter = shotCounter + 1
				playHitSound()
			end
		end
	end)
	
	lastShotAt = tick()
	if KillAura.ShotDelay > 0 then task.wait(KillAura.ShotDelay) end
	killAuraMaybeAutoReload()
	return true
end

function killAuraPickTargets()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local ok, char, part, root, dist, origin, hitPos, aimPos = killAuraValidTarget(plr)
		if ok then
			list[#list+1] = {
				plr = plr, char = char, part = part, root = root,
				dist = dist, origin = origin, hitPos = hitPos, aimPos = aimPos,
				afk = isAFK(root),
			}
		end
	end
	table.sort(list, function(a, b)
		if a.afk ~= b.afk then return a.afk end
		return a.dist < b.dist
	end)
	if KillAura.OnlyNearest and list[1] then return {list[1]} end
	return list
end

function killAuraLoop(token)
	while KillAura.Enabled and combatToken == token and PlumeRunning do
		pcall(function()
			if not CombatEvent or not CombatEvent.Parent then loadCombatEvent() end
			if not holdingTool() then task.wait(0.15); return end
			local targets = killAuraPickTargets()
			if #targets == 0 then
				lastShotPlr = nil; sameTargetCount = 0; task.wait(0.1); return
			end
			for i = 1, #targets do
				if not KillAura.Enabled or combatToken ~= token then break end
				local e = targets[i]
				if not (e.char and e.char.Parent) then continue end
				if KillAura.DeathCheck and not IsCharacterAlive(e.char) then continue end
				if hasFF(e.char) then continue end
				if e.plr == lastShotPlr then
					sameTargetCount = sameTargetCount + 1
					if sameTargetCount > KillAura.MaxSameTarget then
						if #targets > 1 then continue end; sameTargetCount = 0
					end
				else lastShotPlr = e.plr; sameTargetCount = 1 end
				killAuraFireEntry(e)
			end
		end)
		task.wait(KillAura.CycleGap)
	end
end

function setKillAuraRunning(on)
	if on then
		combatToken = combatToken + 1; KillAura.Enabled = true
		lastShotPlr = nil; sameTargetCount = 0
		task.spawn(killAuraLoop, combatToken)
	else
		KillAura.Enabled = false; combatToken = combatToken + 1
		lastShotPlr = nil; sameTargetCount = 0
	end
end

