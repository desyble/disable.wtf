local BODY_PARTS = {
	"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand",
	"RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg",
	"LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot","Torso","LeftArm","RightArm","LeftLeg","RightLeg",
}
local function getBodyBoundingBox(char)
	local minV = Vector3.new(math.huge,math.huge,math.huge)
	local maxV = Vector3.new(-math.huge,-math.huge,-math.huge)
	local found = false
	local backup = hitboxBackups[char]
	for _, name in ipairs(BODY_PARTS) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local originalSize = backup and backup[part] or part.Size
			local pos, half = part.Position, originalSize / 2
			minV = Vector3.new(math.min(minV.X,pos.X-half.X),math.min(minV.Y,pos.Y-half.Y),math.min(minV.Z,pos.Z-half.Z))
			maxV = Vector3.new(math.max(maxV.X,pos.X+half.X),math.max(maxV.Y,pos.Y+half.Y),math.max(maxV.Z,pos.Z+half.Z))
			found = true
		end
	end
	if not found then return char:GetBoundingBox() end
	return CFrame.new((minV+maxV)/2), maxV-minV
end

local function updateEsp()
	local anyEspActive = ESP.Enabled or ESP.ShowHealthBar or ESP.ShowName or ESP.ShowDistance or ESP.FillEnabled
	if not anyEspActive then
		for p in pairs(espBoxes) do removeEspBox(p) end; return
	end
	local camera = Workspace.CurrentCamera; if not camera then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local alive = char and IsCharacterAlive(char)
			if char and alive then
				local e = getEspBox(player)
				local cf, size = getBodyBoundingBox(char)
				local hx, hy, hz = size.X/2, size.Y/2, size.Z/2
				local corners = {
					cf*Vector3.new(hx,hy,hz), cf*Vector3.new(-hx,hy,hz),
					cf*Vector3.new(hx,-hy,hz), cf*Vector3.new(-hx,-hy,hz),
					cf*Vector3.new(hx,hy,-hz), cf*Vector3.new(-hx,hy,-hz),
					cf*Vector3.new(hx,-hy,-hz), cf*Vector3.new(-hx,-hy,-hz),
				}
				local minX, minY = math.huge, math.huge
				local maxX, maxY = -math.huge, -math.huge
				local onScreen = false
				for _, c in ipairs(corners) do
					local sp, vis = camera:WorldToViewportPoint(c)
					if vis and sp.Z > 0 then
						onScreen = true
						minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
						maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
					end
				end
				if onScreen then
					e.container.Position = UDim2.new(0,minX,0,minY)
					e.container.Size = UDim2.new(0,maxX-minX,0,maxY-minY)
					e.container.Visible = true

					e.mainOutline.Visible = ESP.Enabled
					e.outerOutline.Visible = ESP.Enabled
					e.innerOutline.Visible = ESP.Enabled
					if e.glowFrame then
						e.glowFrame.Visible = ESP.Enabled and ESP.BoxGlow
					end

					e.fillBox.Visible = ESP.FillEnabled

					e.nameLabel.Text = ESP.ShowName and player.DisplayName or ""
					e.nameLabel.Visible = ESP.ShowName
					if ESP.ShowDistance then
						local hrp = char:FindFirstChild("HumanoidRootPart")
						local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if hrp and myHrp then e.distLabel.Text = tostring(math.floor((hrp.Position-myHrp.Position).Magnitude)) end
						e.distLabel.Visible = true
					else e.distLabel.Visible = false end

					if ESP.ShowHealthBar then
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							local hp = hum:GetAttribute("Health") or hum.Health
							local pct = math.clamp(hp / 100, 0, 1)
							e.healthFill.Size = UDim2.new(1, 0, pct, 0)
							e.healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
						end
						e.healthBg.Visible = true
					else
						e.healthBg.Visible = false
					end
				else e.container.Visible = false end
			else removeEspBox(player) end
		end
	end
	for p in pairs(espBoxes) do if not p.Parent then removeEspBox(p) end end
end

