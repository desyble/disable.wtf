local function applySkinToTool(tool, skinName, category)
	if skinName == "None" then
		clearOverlay()
		return true
	end

	local gunModels = ReplicatedStorage:FindFirstChild("GunModels")
	if not gunModels then return false end
	local catFolder = gunModels:FindFirstChild(category)
	if not catFolder then return false end
	local skinTool = catFolder:FindFirstChild(skinName)
	if not skinTool then return false end

	if activeOverlay and activeTool == tool and activeSkin == skinName then
		return true
	end

	clearOverlay()

	local clone = skinTool:Clone()

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BaseScript") then
			desc:Destroy()
		end
	end

	for _, part in ipairs(clone:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
		end
	end

	local realHandle = tool:FindFirstChild("Handle")
	local cloneHandle = clone:FindFirstChild("Handle")
	if not realHandle or not cloneHandle then
		clone:Destroy()
		return false
	end

	cloneHandle.CFrame = realHandle.CFrame
	local weld = Instance.new("Weld")
	weld.Part0 = realHandle
	weld.Part1 = cloneHandle
	weld.C0 = CFrame.new()
	weld.C1 = CFrame.new()
	weld.Parent = cloneHandle

	local container = getOverlayContainer()
	if not container then
		clone:Destroy()
		return false
	end
	clone.Parent = container

	for _, part in ipairs(tool:GetDescendants()) do
		if part:IsA("BasePart") then
			hiddenParts[part] = part.LocalTransparencyModifier
			part.LocalTransparencyModifier = 1
		end
	end

	activeOverlay = clone
	activeTool = tool
	activeSkin = skinName

	local skinCfg = nil
	local cfgModule = Configuration and Configuration:FindFirstChild(skinName)
	if cfgModule and cfgModule:IsA("ModuleScript") then
		local s, c = pcall(require, cfgModule)
		if s then skinCfg = c end
	end
	applySkinSounds(tool, skinCfg)

	return true
end



local function tryApplySkinChanger()
	if not SkinChanger.Enabled then
		clearOverlay()
		return
	end
	local char = LocalPlayer.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		clearOverlay()
		return
	end
	local cat = getWeaponCategory(tool)
	if not cat then
		clearOverlay()
		return
	end
	local skin = cat == "Glock" and SkinChanger.PistolSkin or SkinChanger.RifleSkin
	applySkinToTool(tool, skin, cat)
end

local function setupSkinChangerForCharacter(char)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			task.wait(0.15)
