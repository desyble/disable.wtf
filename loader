local function updateTracerESP()
	if not TracerESP.Enabled then
		removeAllTracerEsp()
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local viewportSize = cam.ViewportSize
	local originX, originY
	if TracerESP.Origin == "Bottom" then
		originX, originY = viewportSize.X / 2, viewportSize.Y
	elseif TracerESP.Origin == "Top" then
		originX, originY = viewportSize.X / 2, 0
	elseif TracerESP.Origin == "Center" then
		originX, originY = viewportSize.X / 2, viewportSize.Y / 2
	else
		local mp = UserInputService:GetMouseLocation()
		originX, originY = mp.X, mp.Y
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			if char and IsCharacterAlive(char) then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
					if onScreen and screenPos.Z > 0 then
						local from2 = Vector2.new(originX, originY)
						local to2   = Vector2.new(screenPos.X, screenPos.Y)
						local t = getTracerEspLine(plr)

						t.outline.From      = from2
						t.outline.To        = to2
						t.outline.Thickness = TracerESP.Thickness + 2
						t.outline.Visible   = true

						for i = 1, TRACER_SEGMENTS do
							local a0 = (i - 1) / TRACER_SEGMENTS
							local a1 = i       / TRACER_SEGMENTS
							local c  = TracerESP.Color
							local col = Color3.new(
								1 + (c.R - 1) * a0,
								1 + (c.G - 1) * a0,
								1 + (c.B - 1) * a0
							)
							local seg = t.segments[i]
							seg.From      = from2 + (to2 - from2) * a0
							seg.To        = from2 + (to2 - from2) * a1
							seg.Color     = col
							seg.Thickness = TracerESP.Thickness
							seg.Visible   = true
						end
					else
						removeTracerEspLine(plr)
					end
				else
					removeTracerEspLine(plr)
				end
			else
				removeTracerEspLine(plr)
			end
		end
	end
	for plr in pairs(tracerEspLines) do
		if not plr.Parent then removeTracerEspLine(plr) end
	end
end

