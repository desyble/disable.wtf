local function buildSkinList(category)
	local skins = {"None"}
	local gunModels = ReplicatedStorage:FindFirstChild("GunModels")
	if not gunModels then return skins end
	local folder = gunModels:FindFirstChild(category)
	if not folder then return skins end
	for _, t in ipairs(folder:GetChildren()) do
		if t:IsA("Tool") then skins[#skins + 1] = t.Name end
	end
	table.sort(skins, function(a, b)
		if a == "None" then return true end
		if b == "None" then return false end
		return a:lower() < b:lower()
	end)
	return skins
end

