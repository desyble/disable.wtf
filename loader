local function spawnNeverloseTracer(startPos, endPos)
	if not BulletTracer.Enabled or not startPos or not endPos then return end
	local distance = (endPos - startPos).Magnitude
	if distance < 1 then return end

	local p0 = Instance.new("Part")
	p0.Name = "TracerTail"
	p0.Size = Vector3.new(0.01, 0.01, 0.01)
	p0.Transparency = 1; p0.Anchored = true; p0.CanCollide = false
	p0.CanQuery = false; p0.CanTouch = false; p0.CastShadow = false
	p0.CFrame = CFrame.new(startPos)
	p0.Parent = tracerFolder

	local p1 = Instance.new("Part")
	p1.Name = "TracerHead"
	p1.Size = Vector3.new(0.01, 0.01, 0.01)
	p1.Transparency = 1; p1.Anchored = true; p1.CanCollide = false
	p1.CanQuery = false; p1.CanTouch = false; p1.CastShadow = false
	p1.CFrame = CFrame.new(startPos)
	p1.Parent = tracerFolder

	local a0 = Instance.new("Attachment", p0)
	local a1 = Instance.new("Attachment", p1)

	local coreBeam = Instance.new("Beam")
	coreBeam.Name = "CoreLaser"
	coreBeam.Attachment0 = a0
	coreBeam.Attachment1 = a1
	coreBeam.Width0 = BulletTracer.Thickness * 0.6
	coreBeam.Width1 = BulletTracer.Thickness * 0.6
	coreBeam.Color = ColorSequence.new(BulletTracer.CoreColor)
	coreBeam.FaceCamera = true
	coreBeam.LightEmission = 1
	coreBeam.LightInfluence = 0
	coreBeam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(0.8, 0.1),
		NumberSequenceKeypoint.new(1, 0)
	})
	coreBeam.Parent = p0

	local glowBeam = Instance.new("Beam")
	glowBeam.Name = "GlowLaser"
	glowBeam.Attachment0 = a0
	glowBeam.Attachment1 = a1
	glowBeam.Width0 = BulletTracer.Thickness * 2.4
	glowBeam.Width1 = BulletTracer.Thickness * 2.4
	glowBeam.Color = ColorSequence.new(BulletTracer.Color)
	glowBeam.FaceCamera = true
	glowBeam.LightEmission = 0.85
	glowBeam.LightInfluence = 0
	glowBeam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(0.7, 0.45),
		NumberSequenceKeypoint.new(1, 0.15)
	})
	glowBeam.Parent = p0

	local travelTime = math.clamp(distance / 1600, 0.03, 0.08)
	local tweenInfoTravel = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)

	local tweenTravel = TweenService:Create(p1, tweenInfoTravel, {
		CFrame = CFrame.new(endPos)
	})
	tweenTravel:Play()

	local fadeDuration = 0.6
	local holdTime = math.max(BulletTracer.Duration - fadeDuration - travelTime, 0)

	task.delay(travelTime + holdTime, function()
		if not p0 or not p0.Parent then return end
		local startTime = tick()
		local fadeConn
		fadeConn = RunService.RenderStepped:Connect(function()
			local elapsed = tick() - startTime
			local alpha = math.clamp(elapsed / fadeDuration, 0, 1)

			if coreBeam and coreBeam.Parent then
				coreBeam.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, math.clamp(0.5 + alpha * 0.5, 0, 1)),
					NumberSequenceKeypoint.new(0.8, math.clamp(0.1 + alpha * 0.9, 0, 1)),
					NumberSequenceKeypoint.new(1, math.clamp(alpha, 0, 1))
				})
			end
			if glowBeam and glowBeam.Parent then
				glowBeam.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, math.clamp(0.85 + alpha * 0.15, 0, 1)),
					NumberSequenceKeypoint.new(0.7, math.clamp(0.45 + alpha * 0.55, 0, 1)),
					NumberSequenceKeypoint.new(1, math.clamp(0.15 + alpha * 0.85, 0, 1))
				})
			end

			if alpha >= 1 then
				fadeConn:Disconnect()
				if p0 then p0:Destroy() end
				if p1 then p1:Destroy() end
			end
		end)
	end)
end

