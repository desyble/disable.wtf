local function copyVisualProps(srcPart, dstPart)
	if not srcPart or not dstPart then return end
	if not srcPart:IsA("BasePart") or not dstPart:IsA("BasePart") then return end
	dstPart.Color = srcPart.Color
	dstPart.Material = srcPart.Material
	dstPart.Transparency = srcPart.Transparency
	dstPart.Reflectance = srcPart.Reflectance
	if srcPart:IsA("MeshPart") and dstPart:IsA("MeshPart") then
		pcall(function() dstPart.MeshId = srcPart.MeshId end)
		pcall(function() dstPart.TextureID = srcPart.TextureID end)
	end
	local sMesh = srcPart:FindFirstChildOfClass("SpecialMesh")
	local dMesh = dstPart:FindFirstChildOfClass("SpecialMesh")
	if sMesh then
		if not dMesh then
			dMesh = Instance.new("SpecialMesh")
			dMesh.Parent = dstPart
		end
		pcall(function() dMesh.MeshId = sMesh.MeshId end)
		pcall(function() dMesh.TextureId = sMesh.TextureId end)
		dMesh.Scale = sMesh.Scale
		dMesh.Offset = sMesh.Offset
	elseif dMesh then
		dMesh:Destroy()
	end
	for _, c in ipairs(dstPart:GetChildren()) do
		if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture") then
			c:Destroy()
		end
	end
	for _, c in ipairs(srcPart:GetChildren()) do
		if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture") then
			c:Clone().Parent = dstPart
		end
	end
end

