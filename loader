local AAConn = RunService.RenderStepped:Connect(function(dt)
	if AntiAim.Mode == 0 and not InvertAA.Enabled then return end
	local char = LocalPlayer.Character; if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or not IsCharacterAlive(char) then return end

	pcall(function() hum.AutoRotate = false end)
	local cam = Workspace.CurrentCamera
	local base = cam and cam.CFrame.LookVector or hrp.CFrame.LookVector
	local baseYaw = math.atan2(-base.X, -base.Z)
	local yaw = baseYaw

	if AntiAim.Mode == 1 then
		aaYaw = aaYaw + AntiAim.Speed * dt * 15
		yaw = math.rad(aaYaw)
	elseif AntiAim.Mode == 2 then
		yaw = baseYaw + math.rad((math.floor(tick() * 12) % 2 == 0) and AntiAim.Jitter or -AntiAim.Jitter)
	elseif AntiAim.Mode == 3 then
		yaw = baseYaw + math.pi
	elseif AntiAim.Mode == 4 then
		if math.floor(tick() * 8) ~= math.floor((tick() - dt) * 8) then
			aaYaw = math.random() * math.pi * 2
		end
		yaw = aaYaw
	elseif AntiAim.Mode == 5 then
		if EmoteAA.Enabled then
			yaw = baseYaw
		else
			yaw = baseYaw + math.rad(math.sin(tick() * 6) * AntiAim.Sway)
		end
	end

	local vel = hrp.AssemblyLinearVelocity
	local move = hum.MoveDirection
	if move.Magnitude > 0.05 then
		local spd = hum.WalkSpeed
		vel = Vector3.new(move.X * spd, vel.Y, move.Z * spd)
	end
	local targetCF = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
	if InvertAA.Enabled then
		targetCF = targetCF * CFrame.Angles(math.pi, 0, 0)
	end
	hrp.CFrame = targetCF
	hrp.AssemblyLinearVelocity = vel
end)

local BHopConn = RunService.Heartbeat:Connect(function(dt)
	if not BHop.Enabled then bhopCurrentSpeed = 0; bhopSmoothVel = 0; return end
	local char = LocalPlayer.Character; if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	if not hum or not hrp or not IsCharacterAlive(char) then return end
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	local move, vel = hum.MoveDirection, hrp.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local smoothAccel = BHop.Accel * dt * 60
	local jumpVel = BHop.JumpDist * 0.8
	if grounded then
		if not bhopWasGrounded then
			local target = math.min(flat.Magnitude + BHop.Gain, BHop.Max)
			bhopSmoothVel = bhopSmoothVel + (target - bhopSmoothVel) * math.min(smoothAccel * 0.5, 1)
		else
			if move.Magnitude < 0.05 then
				bhopSmoothVel = math.max(BHop.Start, bhopSmoothVel * BHop.Friction)
			else
				bhopSmoothVel = bhopSmoothVel + (BHop.Max - bhopSmoothVel) * math.min(smoothAccel * 0.15, 0.3)
			end
		end
		bhopCurrentSpeed = math.clamp(bhopSmoothVel, BHop.Start, BHop.Max)
		if move.Magnitude > 0.05 then
			local w = Vector3.new(move.X, 0, move.Z).Unit * math.min(bhopCurrentSpeed, BHop.Max)
			hrp.AssemblyLinearVelocity = Vector3.new(w.X, jumpVel, w.Z)
		else
			hrp.AssemblyLinearVelocity = Vector3.new(0, jumpVel, 0)
		end
		bhopWasGrounded = true
	else
		if move.Magnitude > 0.05 then
			local wish = Vector3.new(move.X, 0, move.Z).Unit
			local curr = flat
			local add = bhopCurrentSpeed * BHop.Strafe - curr:Dot(wish)
			if add > 0 then curr = curr + wish * math.min(smoothAccel * bhopCurrentSpeed * 0.5, add) end
			bhopSmoothVel = bhopSmoothVel + (BHop.Max - bhopSmoothVel) * math.min(smoothAccel * 0.05, 0.15)
			bhopCurrentSpeed = math.clamp(bhopSmoothVel, BHop.Start, BHop.Max)
			if curr.Magnitude > BHop.Max then curr = curr.Unit * BHop.Max end
			hrp.AssemblyLinearVelocity = Vector3.new(curr.X, vel.Y, curr.Z)
		end
		bhopWasGrounded = false
	end
end)

local SpeedConn = RunService.Heartbeat:Connect(function(dt)
