do
	local _RE = ReplicatedStorage:FindFirstChild("RespawnEvent")
	local function _fAR() if not AutoRevive.Enabled then return end; if not _RE then _RE = ReplicatedStorage:FindFirstChild("RespawnEvent") end; if _RE then pcall(function() _RE:FireServer() end) end end
	local function _sAR(ch)
		if not ch then return end; local hm = ch:FindFirstChildOfClass("Humanoid"); if not hm then return end
		local function tryR() if AutoRevive.Enabled then task.wait(0.5); _fAR() end end
		if hm:GetAttribute("Dead") == true then tryR() end
		hm:GetAttributeChangedSignal("Dead"):Connect(function() if hm:GetAttribute("Dead") == true then tryR() end end)
		hm.Died:Connect(tryR); hm.HealthChanged:Connect(function(hp) if hp <= 0 then tryR() end end)
	end
	if LocalPlayer.Character then _sAR(LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(function(c) task.wait(0.5); _sAR(c) end)
end

